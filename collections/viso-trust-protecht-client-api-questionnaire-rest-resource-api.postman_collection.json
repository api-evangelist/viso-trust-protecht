          "id": "624e65a8-0aca-4bc1-aa80-d66ab252e431",
          "name": "Get all questionnaires available to your organization.",
          "request": {
            "name": "Get all questionnaires available to your organization.",
            "description": {
              "content": "Returns the active questionnaires configured for your organization. Use `GET /relationships/{id}/questionnaires` to see which questionnaires are enabled for a particular relationship, and `PUT /relationships/{id}/questionnaires` to enable or disable them per relationship before passing their ids to the Start Assessment endpoint via the `questionnaires` field.",
              "type": "text/plain"
            },
